# Cartile Tenant veya Merkezi API Adresi
# Ornek: https://demo.cartile.com.tr/api/v1 veya https://app.cartile.com.tr/api/v1
CARTILE_BASE_URL=https://demo.cartile.com.tr/api/v1

# Cartile panelinden -> Ayarlar -> API ve Webhook ekranindan alinan anahtar
CARTILE_API_KEY=crt_live_replace_with_your_api_key

# HGS Webhook HMAC-SHA256 imzalama gizli anahtari
CARTILE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_secret
